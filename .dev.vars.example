# =========================================================
# GRRM - Environment Variables TEMPLATE
# =========================================================
# File ini adalah TEMPLATE — JANGAN isi dengan nilai asli!
#
# Cara pakai:
#   1. Copy file ini menjadi ".dev.vars"
#   2. Isi nilai asli di ".dev.vars"
#   3. File ".dev.vars" JANGAN di-commit (sudah ada di .gitignore)
#
# File ini AMAN di-commit ke GitHub karena hanya placeholder.
# =========================================================

# --- Blogger API ---
BLOGGER_BLOG_ID=your_blog_id_here
BLOGGER_API_KEY=your_blogger_api_key_here

# --- Google OAuth (untuk admin panel) ---
BLOGGER_CLIENT_ID=your_client_id.apps.googleusercontent.com
BLOGGER_CLIENT_SECRET=your_client_secret_here
BLOGGER_REDIRECT_URI=http://localhost:8788/api/auth/callback

# --- Session Secret (minimal 32 karakter acak) ---
# Generate di: https://www.random.org/strings/
SESSION_SECRET=generate_random_string_here